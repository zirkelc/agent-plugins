      "source": {
        "source": "url",
        "url": "https://github.com/zirkelc/agent-history.git"
      },
      "description": "Exports every Claude Code session and its subagents to a folder as JSONL and Markdown, and commits and pushes it when the folder is a git repository.",
      "author": {
        "name": "Chris Cook",
        "url": "https://github.com/zirkelc"
      },
      "homepage": "https://github.com/zirkelc/agent-history",
